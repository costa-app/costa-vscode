{
  "publisher": "costa",
  "name": "costa-code",
  "displayName": "costa",
  "version": "0.0.1-internal.7",
  "private": true,
  "packageManager": "pnpm@10.4.1",
  "description": "",
  "author": "Jacob Foster Heimark <jake@costa.security>",
  "license": "MIT",
  "homepage": "https://github.com/costa-app/costa-vscode#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/costa-app/costa-vscode"
  },
  "bugs": {
    "url": "https://github.com/costa-app/costa-vscode/issues"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/index.cjs",
  "icon": "res/icon.png",
  "files": [
    "LICENSE.md",
    "dist/*",
    "res/**/*"
  ],
  "engines": {
    "vscode": "^1.107.0"
  },
  "activationEvents": [
    "onStartupFinished",
    "onView:costa.usage",
    "onView:costa.setup",
    "onCommand:costa.login",
    "onCommand:costa.logout",
    "onCommand:costa.sidebar.reveal",
    "onCommand:costa.revealAndRefresh",
    "onCommand:costa.setup.claudeCode",
    "onCommand:costa.setup.codex"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "costa",
          "title": "Costa",
          "icon": "res/icon.svg"
        }
      ]
    },
    "views": {
      "costa": [
        {
          "type": "webview",
          "id": "costa.usage",
          "name": "Usage",
          "when": "costa.loggedIn"
        },
        {
          "type": "webview",
          "id": "costa.setup",
          "name": "Setup"
        }
      ]
    },
    "commands": [
      {
        "command": "costa.login",
        "title": "Login",
        "category": "Costa Code"
      },
      {
        "command": "costa.logout",
        "title": "Logout",
        "category": "Costa Code"
      },
      {
        "command": "costa.sidebar.reveal",
        "title": "Show Costa",
        "category": "Costa Code"
      },
      {
        "command": "costa.revealAndRefresh",
        "title": "Reveal and Refresh Costa",
        "category": "Costa Code"
      },
      {
        "command": "costa.setup.claudeCode",
        "title": "Set up Claude Code",
        "category": "Costa Code"
      },
      {
        "command": "costa.setup.codex",
        "title": "Set up Codex",
        "category": "Costa Code"
      },
      {
        "command": "costa.refresh",
        "title": "Refresh",
        "category": "Costa Code",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "costa.refresh",
          "when": "view == costa.usage",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "costa",
      "properties": {
        "costa.apiToken": {
          "type": "string",
          "default": "",
          "description": "API token for connecting to the Costa service (deprecated - use OAuth2 login instead)"
        },
        "costa.apiBaseUrl": {
          "type": "string",
          "default": "https://ai.costa.app",
          "description": "Base URL for the Costa API"
        },
        "costa.oauth2.clientId": {
          "type": "string",
          "default": "6E1C382C-1034-4466-8CCF-65ED17DBBA3D",
          "description": "OAuth2 client ID for this VS Code extension"
        },
        "costa.oauth2.redirectUri": {
          "type": "string",
          "default": "vscode://costa.costa-code/callback",
          "description": "OAuth2 redirect URI for this VS Code extension (deprecated - CLI handles OAuth now)"
        }
      }
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --external vscode",
    "dev": "pnpm run build --watch --sourcemap",
    "prepare": "pnpm run update",
    "update": "vscode-ext-gen --output src/generated/meta.ts",
    "lint": "eslint .",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "pnpm run build",
    "release": "bumpp --commit --tag v%v --push",
    "release:pre": "bumpp --commit --tag pre-v%v --push",
    "ext:package": "vsce package --no-dependencies",
    "ext:publish": "vsxpub --no-dependencies"
  },
  "dependencies": {
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.19.0",
    "@types/node": "^22.19.3",
    "@types/vscode": "^1.107.0",
    "@vscode/vsce": "^3.7.1",
    "bumpp": "^10.3.2",
    "eslint": "^9.39.2",
    "esno": "^4.8.0",
    "ovsx": "^0.10.7",
    "pnpm": "^10.26.2",
    "reactive-vscode": "^0.2.22",
    "tsdown": "^0.18.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vitest": "^3.2.4",
    "vscode-ext-gen": "^1.5.1",
    "vsxpub": "^0.1.2"
  }
}
